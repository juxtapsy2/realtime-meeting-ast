# LOCAL / docker compose ONLY.
# The deployed (minikube) environment gets its config from GitHub repo
# secrets (secrets.*) and variables (vars.*) via .github/workflows/deploy.yml.
# Do not store deployed credentials here.

# Server Configuration
PORT=8080
DATABASE_URL=postgres://localhost:5432/meeting_ast?sslmode=disable

# AI Provider Configuration
STT_PROVIDER=deepgram
STT_API_KEY=your_deepgram_api_key_here

LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here

# Optional: For OpenAI Whisper STT
# STT_PROVIDER=openai
# STT_API_KEY=your_openai_api_key_here

# Access control: comma-separated allowlist of emails who may use the service.
# When empty, access control is DISABLED and the API is open to everyone.
ALLOWED_EMAILS=bill@example.com,jane@example.com

# The superadmin is a single account configured ONLY here, and sits above the
# database-managed admins. It is implicitly allowlisted (it can always sign in)
# and is the only role that can change settings, admins, or user API keys.
# Deployed value comes from the GitHub repository variable SUPERADMIN_EMAIL.
# SUPERADMIN_EMAIL=bill@example.com

# Regular administrator emails are managed in the DATABASE (table admin_emails)
# from the Admin page. Admins can monitor access and operational state, but
# cannot change configuration. There is no ADMIN_EMAILS variable: nothing in the
# environment or CI can grant or revoke the admin role.

# Secret used to sign session tokens AND to derive the AES-256-GCM key that
# encrypts per-user provider API keys in the database. Use a long random string
# (e.g. `openssl rand -hex 32`). If empty, an ephemeral secret is generated per
# process (sessions reset on every restart) and storing user API keys is
# DISABLED, because they would be unrecoverable after a restart.
# Changing this value makes previously stored user keys undecryptable.
AUTH_HMAC_SECRET=change_me_to_a_long_random_string

# Google OAuth credentials (required when ALLOWED_EMAILS is set).
# Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials and register the redirect
# URL below as an authorized redirect URI.
# GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
# GOOGLE_OAUTH_REDIRECT_URL=https://momast.beeru-overyonder.dev/api/auth/google/callback
